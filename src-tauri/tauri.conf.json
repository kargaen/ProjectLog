{
  "productName": "ProjectLog",
  "version": "../package.json",
  "identifier": "com.kargaen.projectlog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ProjectLog QuickPanel",
        "width": 430,
        "height": 650,
        "minWidth": 300,
        "minHeight": 430,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "timesheet-preview",
        "create": false,
        "title": "ProjectLog Timesheet Preview",
        "url": "index.html?window=timesheet-preview",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QTdGMUU0MkM1MjNFQUQKUldTdFBsSXM1UEdueDJid2hCZ2UvTHdyQW5BaDBmcFRrbUFwOGgvc0JMYi94aTR4VXZCNVBSdVUK",
      "endpoints": [
        "https://github.com/kargaen/ProjectLog/releases/latest/download/latest.json"
      ]
    }
  }
}
